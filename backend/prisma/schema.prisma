// Prisma schema — SeeCar Auto (M02-01)
// Source of truth: docs/database/ERD.md + docs/database/DATA_DICTIONARY.md (M01-02 ACCEPT,
// 17 tables) + G-02 Articles/ArticleSEO + G-04 admin/RBAC (M02_IMPLEMENTATION_DECISIONS.md).
// Decisions applied: PD-01..PD-06 decided by ChatGPT under Henry's full-authority delegation
// (26/11/2026); PD-07/08/09 + D-01..D-09 still pending — nothing in this schema decides them.
//
// IMPORTANT — constraints Prisma 6.19.3 cannot express live in the migration SQL, not here:
// Prisma 6.19.3 does NOT support @@check (verified 26/11/2026: "Attribute not known: @check").
// The following are enforced in backend/prisma/migrations/<init>/migration.sql as raw SQL:
//   - All CHECK constraints (price/total >= 0, quantity > 0, year 1900-2100, year_to >= year_from,
//     non-empty sku/normalized_value/identifier_value, issuer matrix, variant-requires-generation,
//     failed_login_attempts >= 0).
//   - Partial unique indexes (MPN per issuer; one primary identifier per product+type;
//     one primary image per product; products.deleted_at partial index).
//   - UNIQUE NULLS NOT DISTINCT (model_id, generation_id, variant_id, year) on vehicle_applications.
// See docs/database/PRISMA_MAPPING.md for the full list with names + the verification tests.
// updated_at is maintained by Prisma Client (@updatedAt), not by a DB trigger (ERD §12 note 5).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Enums (ERD §12 note 1)
// DB enum type names are the ERD names (product_status, ...) via @@map.

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN

  @@map("product_status")
}

enum AvailabilityStatus {
  IN_STOCK
  OUT_OF_STOCK

  @@map("availability_status")
}

enum IdentifierType {
  PART_NUMBER
  OEM_NUMBER
  MANUFACTURER_PART_NUMBER
  ALTERNATE_NUMBER

  @@map("identifier_type")
}

enum FitmentAction {
  ATTACH
  DETACH

  @@map("fitment_action")
}

enum RedirectEntity {
  CATEGORY
  BRAND
  PRODUCT

  @@map("redirect_entity")
}

enum PaymentMethod {
  COD
  BANK_TRANSFER

  @@map("payment_method")
}

// Values are the ERD proposal; PD-08 (order status lifecycle) is still pending — M05 confirms.
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

// G-02 (Articles) — not in the ERD; added per API_SPEC Article/ArticleSeo schemas.
enum ArticleStatus {
  DRAFT
  PUBLISHED

  @@map("article_status")
}

// M02-05 (D-15, Henry approved 27/11/2026) — reason a refresh session was revoked (FIX-09).
// DB enum type name is the Prisma enum name (no @@map), per Task Brief D-15.
enum RefreshSessionRevocationReason {
  ROTATED
  LOGOUT
  LOGOUT_ALL
  ADMIN_REVOKED
  REUSE_DETECTED
}

// M02-05 (D-16, Henry approved 27/11/2026) — state of a refresh idempotency operation (FIX-23).
// PostgreSQL native enum + Prisma enum (no TEXT + CHECK), per Task Brief D-16.
enum RefreshOperationState {
  PENDING
  COMPLETED
}

// ---------------------------------------------------------------- Catalogue (ERD §4.1-§4.7)

model Brand {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  logoUrl     String?  @map("logo_url") @db.VarChar(1024)
  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  products              Product[]
  issuingIdentifiers    ProductIdentifier[] @relation("IdentifierIssuingBrand")

  @@map("brands")
}

model Category {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  parent       Category? @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children     Category[] @relation("CategoryChildren")
  name         String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  isVisible    Boolean  @default(true) @map("is_visible")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  products          Product[]
  productCategories ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku                 String             @unique @db.VarChar(64)
  name                String             @db.VarChar(255)
  slug                String             @unique @db.VarChar(255)
  shortDescription    String?            @map("short_description") @db.VarChar(500)
  description         String?            @db.Text
  brandId             String             @map("brand_id") @db.Uuid
  brand               Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryId          String             @map("category_id") @db.Uuid
  category            Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status              ProductStatus      @default(DRAFT)
  availabilityStatus  AvailabilityStatus @default(OUT_OF_STOCK) @map("availability_status")
  price               Decimal            @db.Decimal(12, 2)
  publishedAt         DateTime?          @map("published_at") @db.Timestamptz
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz

  identifiers         ProductIdentifier[]
  productCategories   ProductCategory[]
  images              ProductImage[]
  specifications      ProductSpecification[]
  fitments            ProductVehicleFitment[]
  fitmentChangeLogs   FitmentChangeLog[]
  orderItems          OrderItem[]

  @@index([brandId, status])
  @@index([categoryId, status])
  @@index([status, publishedAt(sort: Desc)])
  @@map("products")
}

model ProductIdentifier {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String         @map("product_id") @db.Uuid
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  identifierType   IdentifierType @map("identifier_type")
  identifierValue  String         @map("identifier_value") @db.VarChar(128)
  normalizedValue  String         @map("normalized_value") @db.VarChar(128)
  issuingMakeId    String?        @map("issuing_make_id") @db.Uuid
  issuingMake      VehicleMake?   @relation("IdentifierIssuingMake", fields: [issuingMakeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  issuingBrandId   String?        @map("issuing_brand_id") @db.Uuid
  issuingBrand     Brand?         @relation("IdentifierIssuingBrand", fields: [issuingBrandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  isPrimary        Boolean        @default(false) @map("is_primary")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([productId, identifierType, normalizedValue])
  @@index([normalizedValue, identifierType])
  @@index([productId])
  @@map("product_identifiers")
}

model ProductCategory {
  productId    String   @map("product_id") @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoryId   String   @map("category_id") @db.Uuid
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  displayOrder Int      @default(0) @map("display_order")

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  imageUrl   String   @map("image_url") @db.VarChar(1024)
  altText    String?  @map("alt_text") @db.VarChar(255)
  sortOrder  Int      @default(0) @map("sort_order")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([productId, sortOrder])
  @@map("product_images")
}

// P1 table (FR-013) — designed in the ERD so M03 needs no structural change; P0 carries no rows.
model ProductSpecification {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  specKey      String   @map("spec_key") @db.VarChar(128)
  specValue    String   @map("spec_value") @db.VarChar(512)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([productId, specKey])
  @@map("product_specifications")
}

// ---------------------------------------------------------------- Vehicles (ERD §4.8-§4.12)

model VehicleMake {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  logoUrl   String?  @map("logo_url") @db.VarChar(1024)
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  models               VehicleModel[]
  applications         VehicleApplication[]
  issuingIdentifiers   ProductIdentifier[] @relation("IdentifierIssuingMake")

  @@map("vehicle_makes")
}

model VehicleModel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  makeId    String   @map("make_id") @db.Uuid
  make      VehicleMake @relation(fields: [makeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name      String   @db.VarChar(255)
  slug      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  generations  VehicleGeneration[]
  applications VehicleApplication[]

  @@unique([makeId, slug])
  @@map("vehicle_models")
}

model VehicleGeneration {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelId   String   @map("model_id") @db.Uuid
  model     VehicleModel @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name      String   @db.VarChar(255)
  slug      String   @db.VarChar(255)
  yearFrom  Int      @map("year_from") @db.SmallInt
  yearTo    Int?     @map("year_to") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  variants     VehicleVariant[]
  applications VehicleApplication[]

  @@unique([modelId, slug])
  @@index([modelId])
  @@map("vehicle_generations")
}

model VehicleVariant {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  generationId String   @map("generation_id") @db.Uuid
  generation   VehicleGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name         String   @db.VarChar(255)
  slug         String   @db.VarChar(255)
  note         String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  applications VehicleApplication[]

  @@unique([generationId, slug])
  @@index([generationId])
  @@map("vehicle_variants")
}

model VehicleApplication {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  makeId       String   @map("make_id") @db.Uuid
  make         VehicleMake @relation(fields: [makeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  modelId      String   @map("model_id") @db.Uuid
  model        VehicleModel @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  generationId String?  @map("generation_id") @db.Uuid
  generation   VehicleGeneration? @relation(fields: [generationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variantId    String?  @map("variant_id") @db.Uuid
  variant      VehicleVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  year         Int?     @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  fitments          ProductVehicleFitment[]
  fitmentChangeLogs FitmentChangeLog[]

  @@index([makeId, modelId])
  @@map("vehicle_applications")
}

// ---------------------------------------------------------------- Fitment (ERD §4.13-§4.14)

model ProductVehicleFitment {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId            String             @map("product_id") @db.Uuid
  product              Product            @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  vehicleApplicationId String             @map("vehicle_application_id") @db.Uuid
  vehicleApplication   VehicleApplication @relation(fields: [vehicleApplicationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fitmentNote          String?            @map("fitment_note") @db.Text
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([productId, vehicleApplicationId])
  @@index([productId])
  @@index([vehicleApplicationId])
  @@map("product_vehicle_fitments")
}

model FitmentChangeLog {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId            String             @map("product_id") @db.Uuid
  product              Product            @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  vehicleApplicationId String             @map("vehicle_application_id") @db.Uuid
  vehicleApplication   VehicleApplication @relation(fields: [vehicleApplicationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  action               FitmentAction
  // FK to users.id — added in M02 per ERD §4.18 (was a bare UUID in the ERD).
  changedByAdminId     String             @map("changed_by_admin_id") @db.Uuid
  changedBy            User               @relation("FitmentChangeLogChangedBy", fields: [changedByAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz

  @@index([productId, createdAt(sort: Desc)])
  @@map("fitment_change_logs")
}

// ---------------------------------------------------------------- Redirects (ERD §4.15)

model UrlRedirect {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType RedirectEntity @map("entity_type")
  // Polymorphic target id — no FK by design (ERD §4.15); existence checked at application level.
  entityId   String         @map("entity_id") @db.Uuid
  oldSlug    String         @map("old_slug") @db.VarChar(255)
  newSlug    String         @map("new_slug") @db.VarChar(255)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@unique([entityType, oldSlug])
  @@map("url_redirects")
}

// ---------------------------------------------------------------- Orders — boundary only (ERD §4.16-§4.17, §8)
// Full order design belongs to M05. order_status values are the ERD proposal (PD-08 pending).

model Order {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderCode       String        @unique @map("order_code") @db.VarChar(32)
  customerName    String        @map("customer_name") @db.VarChar(255)
  customerPhone   String        @map("customer_phone") @db.VarChar(32)
  shippingAddress String        @map("shipping_address") @db.Text
  // P1 customer account — no FK in M02-01 (customers table is P1, ERD §4.18).
  customerId      String?       @map("customer_id") @db.Uuid
  paymentMethod   PaymentMethod @map("payment_method")
  status          OrderStatus   @default(PENDING)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productId           String   @map("product_id") @db.Uuid
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(255)
  skuSnapshot         String   @map("sku_snapshot") @db.VarChar(64)
  unitPriceSnapshot   Decimal  @map("unit_price_snapshot") @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------- Articles — G-02 (M02_IMPLEMENTATION_DECISIONS.md §8)
// Per API_SPEC Article / ArticleSeo schemas. Content and SEO metadata are separate tables so
// the Rule Engine / AI never overwrites a manually edited field (BR-004): manualOverride lists
// the fields edited by hand. D-04 blocks only the AI provider/analysis, not these tables.

model Article {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String        @db.VarChar(255)
  slug          String        @unique @db.VarChar(255)
  content       String        @db.Text
  excerpt       String?       @db.VarChar(500)
  coverImageUrl String?       @map("cover_image_url") @db.VarChar(1024)
  status        ArticleStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  seo ArticleSeo?

  @@map("articles")
}

model ArticleSeo {
  articleId         String   @id @map("article_id") @db.Uuid
  article           Article  @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  seoTitle          String?  @map("seo_title") @db.VarChar(255)
  metaDescription   String?  @map("meta_description") @db.VarChar(500)
  focusKeyword      String?  @map("focus_keyword") @db.VarChar(255)
  secondaryKeywords String[] @map("secondary_keywords")
  searchIntent      String?  @map("search_intent") @db.VarChar(255)
  manualOverride    String[] @map("manual_override")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("article_seo")
}

// ---------------------------------------------------------------- Admin / RBAC — G-04 (M02_IMPLEMENTATION_DECISIONS.md §10)
// Per ADR-005, M01-05 RBAC Matrix, API_SPEC §6, API_SECURITY.md.
// Roles are data, never hard-coded (example roles in the matrix are illustrative only).
// No default admin account is created here — secure Super Admin bootstrap belongs to M06-01.

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username            String    @unique @db.VarChar(255)
  // Argon2id encoded hash only (NFR-006, API_SECURITY §1). Never a plaintext password.
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  isActive            Boolean   @default(true) @map("is_active")
  // FR-091 lockout (API_SECURITY §1): consecutive failures -> temporary lock.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  userRoles        UserRole[]
  userPermissions  UserPermission[]
  auditLogs        AuditLog[] @relation("AuditActor")
  fitmentChangeLogs FitmentChangeLog[] @relation("FitmentChangeLogChangedBy")
  refreshSessions  AdminRefreshSession[]

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module      String   @db.VarChar(128)
  action      String   @db.VarChar(128)
  // Permission code is module + "." + action (e.g. "products.create") — derived, not stored twice.
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  granted      Boolean    @default(true)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// FR-083 per-account exceptions. Union with role permissions at check time;
// an explicit granted=false (deny) overrides a role allow (API_SECURITY §2).
model UserPermission {
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  granted      Boolean    @default(true)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

// FR-084 audit log for permission changes (and other admin actions). Append-only.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  action     String   @db.VarChar(255)
  entityType String   @map("entity_type") @db.VarChar(128)
  entityId   String?  @map("entity_id") @db.Uuid
  // Before/after snapshots are genuinely unstructured data (arbitrary entity state) —
  // the ERD §2.2 JSON exception for M02. Never store PII/token/secret here.
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Admin refresh sessions (API_SECURITY §1). Only the token HASH is stored — never plaintext.
// Rotation: a new row per rotation; the old row gets revoked_at set. Reuse detection: a presented
// token whose hash matches a revoked/expired row revokes all sessions of that account (M02-05).
model AdminRefreshSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  // D-15 (M02-05): revocation reason + replacement link (FIX-09). Both NULL ⇔ session ACTIVE.
  revokedReason       RefreshSessionRevocationReason? @map("revoked_reason")
  replacedBySessionId String?                         @map("replaced_by_session_id") @db.Uuid
  replacedBySession   AdminRefreshSession?            @relation("SessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replacedSessions    AdminRefreshSession[]           @relation("SessionReplacement")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_refresh_sessions")
}

// Refresh idempotency operations (D-16, M02-05). PostgreSQL decides operation
// ownership + atomic rotation; Redis only caches the encrypted response envelope.
// expires_at is the operation row's retention deadline (created + refresh TTL
// from config) — NOT a lease; no reclaim, no Redis PENDING claim.
// Never stores plaintext tokens or encrypted responses — only hashes/keys/ids.
model AuthRefreshOperation {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash      String                @map("token_hash") @db.Text
  idempotencyKey String                @map("idempotency_key") @db.Text
  ownerId        String                @map("owner_id") @db.Uuid
  state          RefreshOperationState @default(PENDING)
  expiresAt      DateTime              @map("expires_at") @db.Timestamptz
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tokenHash, idempotencyKey])
  @@map("auth_refresh_operations")
}
