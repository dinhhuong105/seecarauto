{"description":"SEECARAUTO — Automotive Parts E-commerce Platform (monorepo). ChatGPT is Project Manager, Muse is Developer, Henry is Product Owner.","devDependencies":{"prettier":"^3.3.3","turbo":"^2.3.3","typescript":"^5.6.3"},"engines":{"node":">=20","pnpm":">=10"},"name":"seecarauto","packageManager":"pnpm@10.14.0","pnpm":{"onlyBuiltDependencies":["@nestjs/core","esbuild"]},"private":true,"scripts":{"build":"turbo run build","clean":"turbo run clean && rm -rf node_modules","dev":"turbo run dev","docker:config":"docker compose config --quiet","docker:down":"docker compose down","docker:up":"docker compose up -d --build","format":"prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .prettierignore","format:check":"prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .prettierignore","lint":"turbo run lint","test":"turbo run test","typecheck":"turbo run typecheck"},"version":"0.1.0"}