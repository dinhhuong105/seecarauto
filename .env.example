# SEECARAUTO — sample environment configuration.
# Copy to .env and fill in real values locally. NEVER commit a real .env.
# All values below are placeholders / local-dev defaults only.

# --- General ---
NODE_ENV=development
APP_ENV=local

# --- Frontend (customer website) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1
NEXT_PUBLIC_SITE_NAME=SeeCar Auto

# --- Admin dashboard ---
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL_ADMIN=http://localhost:3002/api/v1

# --- Backend (NestJS API) ---
PORT=3002
API_PREFIX=api/v1
API_URL=http://localhost:3002

# --- PostgreSQL ---
DATABASE_URL=postgresql://seecarauto:seecarauto_dev_only@localhost:5432/seecarauto?schema=public
POSTGRES_USER=seecarauto
POSTGRES_PASSWORD=seecarauto_dev_only
POSTGRES_DB=seecarauto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (cache / BullMQ) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CART_TTL_DAYS=30
REDIS_COMMAND_TIMEOUT_MS=1000
QUEUE_CONCURRENCY=5

# --- Meilisearch ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=seecarauto_dev_master_key_only
MEILISEARCH_MASTER_KEY=seecarauto_dev_master_key_only

# --- Storage (S3 / Cloudflare R2) — fill in when the provider is chosen ---
S3_ENDPOINT=
S3_BUCKET=seecarauto-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Auth (JWT) — generate real secrets per environment, never reuse dev values ---
JWT_SECRET=change_me_dev_only
JWT_REFRESH_SECRET=change_me_dev_only
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- AI SEO Assistant (provider + budget decided by Henry, see docs/project-management) ---
AI_PROVIDER=
AI_API_KEY=
AI_API_BUDGET_USD_MONTHLY=
